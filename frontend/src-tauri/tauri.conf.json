{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CANYP Gestion",
  "version": "0.1.0",
  "identifier": "ar.com.canyp.gestion",
  "build": {
    "frontendDist": "../dist/client",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "CANYP Gestion",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "externalBin": [
      "binaries/canyp-backend"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SpanishInternational"],
        "installMode": "currentUser"
      }
    }
  }
}